#!/usr/bin/env bash
export MANGOHUD=0 DISABLE_LSFGVK=1 DISABLE_VKBASALT=1 QSG_RHI_BACKEND=vulkan
unset LD_PRELOAD
# Harmlose Qt-Warnungen ueber kaputte SVG-Icons (leere Masken, fehlerhafte Pfade), fluten sonst das Log
export QT_LOGGING_RULES="${QT_LOGGING_RULES:+$QT_LOGGING_RULES;}qt.svg*.warning=false"
exec /usr/bin/qs "$@"
