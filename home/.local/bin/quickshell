#!/usr/bin/env bash
export MANGOHUD=0 DISABLE_LSFGVK=1 DISABLE_VKBASALT=1 QSG_RHI_BACKEND=vulkan
unset LD_PRELOAD
# Animations follow the real clock instead of fixed steps (otherwise uneven on NVIDIA/Vulkan)
export QSG_USE_SIMPLE_ANIMATION_DRIVER=1
# Hide harmless Qt warnings that would flood the log:
#  qt.svg*: broken SVG icons (empty masks, invalid paths)
#  qt.qpa.wayland.textinput: focus changes when opening/closing panels
export QT_LOGGING_RULES="${QT_LOGGING_RULES:+$QT_LOGGING_RULES;}qt.svg*.warning=false;qt.qpa.wayland.textinput.warning=false"
exec /usr/bin/quickshell "$@"
