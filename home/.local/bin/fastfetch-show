#!/usr/bin/env bash
# fastfetch in the largest variant that fits the terminal completely: no wrapped line, nothing pushed out
# of the window at the top. Variants from large to small: ~/.config/fastfetch/config.jsonc, then
# ~/.config/fastfetch/variants/*.jsonc by file name (2-..., 3-..., ...).
# Used by ~/.local/bin/kitty-shell/zsh (start) and kitty-shell/zdotdir/fastfetch.zsh (resize).
#
#   fastfetch-show start            kitty start: shows the matching variant from the last snapshot RIGHT AWAY
#                                   (same layout, values from the last window) with the next image, then runs
#                                   fastfetch fresh and swaps in the new values in one step (synchronized,
#                                   the image stays the same). Draws to the terminal itself.
#   fastfetch-show prerender        (in the background) render and measure all variants for this window ahead,
#                                   so a later redraw is instant; then store them as the snapshot for the
#                                   next kitty
#   fastfetch-show redraw NAME IMG  after a resize: if the shown variant NAME still fits and no larger one does,
#                                   everything stays ("same"); otherwise the new variant, with the image
#                                   IMG of this window (empty: it had none yet -> next image)
#
# Output on stdout: first line "shown<Tab>variant<Tab>image", "none" (nothing fits) or "same"; for redraw
# followed by the fastfetch output to show. The image in it is a fixed file from the cache (not
# logo-current*.png), so every window keeps its own image.
# The pre-rendered variants of each window are in $FF_WD (set by kitty-shell/zsh, e.g. /run/user/1000/kitty-fastfetch/pts-3),
# the snapshot for the next kitty is in ~/.cache/kitty-fastfetch.
DIR="$HOME/.config/fastfetch"
BIN="$HOME/.local/bin"
SIZES="$DIR/.variant-sizes"
SNAP="${XDG_CACHE_HOME:-$HOME/.cache}/kitty-fastfetch"
MODE=${1:-start}
WD=${FF_WD:-}
TAB=$'\t'
ESC=$'\e'

ZSH=/usr/bin/zsh; [ -x "$ZSH" ] || ZSH=/bin/zsh; [ -x "$ZSH" ] || ZSH=
# Run fastfetch with a config. Through zsh, so fastfetch shows zsh as "Shell" (it looks at
# the parent process). The x at the end keeps $(...) from cutting off the trailing empty lines.
run_ff() {
    if [ -n "$ZSH" ]; then
        "$ZSH" -f -c 'fastfetch --pipe false -c "$1" 2>/dev/null; print -n x' zsh "$1"
    else
        fastfetch --pipe false -c "$1" 2>/dev/null; printf x
    fi
}
measure() { printf '%s' "$1" | "$BIN/fastfetch-fit" --measure 2>/dev/null; }
# base64 of the image paths (each path goes through base64 only once)
declare -A B64C=()
# Read a whole file (without cat, keeping all trailing blank lines)
slurp() { IFS= read -r -d '' "$1" < "$2"; return 0; }

CONFIGS=("$DIR/config.jsonc")
for f in "$DIR"/variants/*.jsonc; do [ -f "$f" ] && CONFIGS+=("$f"); done
# Image of each config (logo.source) and its size in cells; empty if it has none
declare -A SRCOF=() CELLSOF=()
for f in "${CONFIGS[@]}"; do
    slurp txt "$f"
    if [[ $txt == *'"kitty-direct"'* && $txt =~ \"source\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then
        SRCOF[$f]=${BASH_REMATCH[1]}
        c=; n=
        [[ $txt =~ \"width\"[[:space:]]*:[[:space:]]*([0-9]+) ]] && c=${BASH_REMATCH[1]}
        [[ $txt =~ \"height\"[[:space:]]*:[[:space:]]*([0-9]+) ]] && n=${BASH_REMATCH[1]}
        CELLSOF[$f]="${c}x${n}"
    fi
done
unset txt
MAINCELLS=${CELLSOF[$DIR/config.jsonc]:-}

# Image files of this window ("<columns>x<rows><Tab>file" per line)
declare -A IMG=()
load_img() { local s p; while IFS="$TAB" read -r s p; do [ -n "$p" ] && IMG[$s]=$p; done; }
# Switch the image in the output from logo-current*.png to this window's fixed file (result in FIXED)
fix_img() {  # output config
    FIXED=$1
    local src=${SRCOF[$2]:-} cells=${CELLSOF[$2]:-} a b
    if [ -n "$src" ] && [ -n "${IMG[$cells]:-}" ]; then
        [ -n "${B64C[$src]:-}" ] || B64C[$src]=$(printf '%s' "$src" | base64 -w0)
        [ -n "${B64C[${IMG[$cells]}]:-}" ] || B64C[${IMG[$cells]}]=$(printf '%s' "${IMG[$cells]}" | base64 -w0)
        a=${B64C[$src]}; b=${B64C[${IMG[$cells]}]}
        FIXED=${FIXED//"$a"/"$b"}
    fi
}
# Store all pre-rendered variants with this window's image (<variant>.fixed). That way
# fastfetch.zsh can print the finished file directly when redrawing, without starting this script.
write_fixed_all() {
    [ -n "$WD" ] || return 0
    local cfg name out
    for cfg in "${CONFIGS[@]}"; do
        name=${cfg##*/}
        [ -f "$WD/$name.out" ] || continue
        slurp out "$WD/$name.out"
        if [ -n "${SRCOF[$cfg]:-}" ] && [[ "$out" == *"$ESC"_G* ]]; then
            [ ${#IMG[@]} -gt 0 ] || continue  # this window's image is not decided yet
            fix_img "$out" "$cfg"; out=$FIXED
        fi
        printf '%s' "$out" > "$WD/$name.fixed.tmp.$$" && mv -f "$WD/$name.fixed.tmp.$$" "$WD/$name.fixed"
    done
}
# Take the next image without fastfetch-logo: it already prepared it in the background (.next-image)
img_fast() {
    local f="$DIR/.next-image" cur nxt src idx s p name
    [ -s "$f" ] || return 1
    { read -r cur nxt; IFS= read -r src; } < "$f"
    idx=; [ -f "$DIR/.logo-index" ] && read -r idx < "$DIR/.logo-index"
    [ "${idx:--1}" = "$cur" ] && [ -n "$src" ] && [ -f "$src" ] || return 1
    IMG=()
    load_img < <(tail -n +3 "$f")
    for s in "${!IMG[@]}"; do [ -s "${IMG[$s]}" ] || return 1; done
    [ ${#IMG[@]} -gt 0 ] || return 1
    CHOSEN_SRC=$src
    FAST_NEXT=$nxt
    return 0
}
# What is left to do after taking the image (on start only after the instant display)
commit_img() {
    local s p name
    if [ -n "$FAST_NEXT" ]; then
        printf '%s' "$FAST_NEXT" > "$DIR/.logo-index"
        rm -f "$DIR/.next-image"
        # Point the logo-current*.png links (fastfetch by hand, fresh runs) at the new image
        for s in "${!IMG[@]}"; do
            if [ "$s" = "$MAINCELLS" ]; then name="$DIR/logo-current.png"; else name="$DIR/logo-current-$s.png"; fi
            p=${IMG[$s]}
            ln -sfn ".logo-cache/${p##*/}" "$name"
        done
        # Prepare the image for the kitty after this one in the background
        setsid -f nice -n 10 "$BIN/fastfetch-logo" prepare-next >/dev/null 2>&1 </dev/null
        FAST_NEXT=
    fi
    if [ -n "$WD" ] && [ ${#IMG[@]} -gt 0 ]; then
        { printf '%s\n' "$CHOSEN_SRC"; for s in "${!IMG[@]}"; do printf '%s\t%s\n' "$s" "${IMG[$s]}"; done; } > "$WD/img.tmp.$$" \
            && mv -f "$WD/img.tmp.$$" "$WD/img"
    fi
    write_fixed_all
    PENDING=
}
# Decide the image for this window: IMG given -> its files, otherwise take the next image
CHOSEN_SRC=
IMG_DONE=
FAST_NEXT=
PENDING=
DEFER=
pick_img() {
    local want=$1 lines
    IMG_DONE=1
    if [ -n "$want" ] && [ -f "$want" ]; then
        if [ -n "$WD" ] && [ -s "$WD/img" ] && [ "$(head -n1 "$WD/img")" = "$want" ]; then
            load_img < <(tail -n +2 "$WD/img")
        else
            lines=$("$BIN/fastfetch-logo" files "$want" 2>/dev/null)
            load_img <<< "$lines"
            [ -n "$WD" ] && { printf '%s\n%s\n' "$want" "$lines" > "$WD/img.tmp.$$" && mv -f "$WD/img.tmp.$$" "$WD/img"; }
            write_fixed_all
        fi
        CHOSEN_SRC=$want
    else
        if ! img_fast; then
            IMG=()
            lines=$("$BIN/fastfetch-logo" take 2>/dev/null) || return 0
            CHOSEN_SRC=$(head -n1 <<< "$lines")
            load_img < <(tail -n +2 <<< "$lines")
        fi
        PENDING=1
        [ -n "$DEFER" ] || commit_img
    fi
}

read -r TR TC < <(stty size </dev/tty 2>/dev/null)
size_ok=; [[ "${TR:-}" =~ ^[1-9][0-9]*$ && "${TC:-}" =~ ^[1-9][0-9]*$ ]] && size_ok=1
can_measure=; [ -x "$BIN/fastfetch-fit" ] && command -v python3 >/dev/null && can_measure=1

# If an image is missing (e.g. the small sizes the first time), prepare it first without switching.
# Otherwise fastfetch would use its ASCII logo instead of the image.
ensure_links() {
    local f
    for f in "${CONFIGS[@]}"; do
        if [ -n "${SRCOF[$f]:-}" ] && [ ! -e "${SRCOF[$f]}" ]; then
            [ -x "$BIN/fastfetch-logo" ] && "$BIN/fastfetch-logo" >/dev/null 2>&1
            return
        fi
    done
}

# Get a variant (pre-rendered or now): sets OUT, NC, NR
get_variant() {
    local cfg=$1 name=${1##*/}
    if [ -n "$WD" ] && [ -f "$WD/$name.out" ] && [ -f "$WD/$name.size" ]; then
        read -r NC NR < "$WD/$name.size"
        slurp OUT "$WD/$name.out"
    else
        fresh_variant "$cfg" || return 1
    fi
    [[ "${NC:-}" =~ ^[0-9]+$ && "${NR:-}" =~ ^[0-9]+$ ]]
}
# Render and measure one variant fresh now (stored for this window): sets OUT, NC, NR
fresh_variant() {
    local cfg=$1 name=${1##*/}
    OUT=$(run_ff "$cfg"); OUT=${OUT%x}
    NC=; NR=
    read -r NC NR < <(measure "$OUT")
    [[ "${NC:-}" =~ ^[0-9]+$ && "${NR:-}" =~ ^[0-9]+$ ]] || return 1
    if [ -n "$WD" ]; then
        printf '%s' "$OUT" > "$WD/$name.out.tmp.$$" && mv -f "$WD/$name.out.tmp.$$" "$WD/$name.out"
        printf '%s %s\n' "$NC" "$NR" > "$WD/$name.size.tmp.$$" && mv -f "$WD/$name.size.tmp.$$" "$WD/$name.size"
    fi
    return 0
}
# Output with this window's image (sets FIXED); takes the image if the variant has one
with_img() {  # config output
    FIXED=$2
    if [ -n "${SRCOF[$1]:-}" ] && [[ "$2" == *"$ESC"_G* ]]; then
        [ -n "$IMG_DONE" ] || pick_img "${WANT_SRC:-}"
        fix_img "$2" "$1"
    fi
}
# Redraw in one step: kitty only shows the finished result (synchronized), no intermediate state
REDRAW_PRE="$ESC[?2026h${ESC}_Ga=d,d=A$ESC\\$ESC[H$ESC[2J$ESC[3J"
REDRAW_POST="$ESC[?2026l"

# Last measured sizes of all windows ("file columns rows"), so that without a snapshot clearly too large
# variants don't have to run first. Invalid as soon as a config is newer.
declare -A KNOWN=()
if [ -f "$SIZES" ]; then
    fresh=1
    for f in "${CONFIGS[@]}"; do [ "$f" -nt "$SIZES" ] && fresh=; done
    if [ -n "$fresh" ]; then
        while read -r name c r; do
            [[ "${c:-}" =~ ^[0-9]+$ && "${r:-}" =~ ^[0-9]+$ ]] && KNOWN[$name]="$c $r"
        done < "$SIZES"
    fi
fi
save_sizes() {
    local k
    for k in "${!KNOWN[@]}"; do printf '%s %s\n' "$k" "${KNOWN[$k]}"; done > "$SIZES.tmp.$$" && mv -f "$SIZES.tmp.$$" "$SIZES"
}
fits() { [ "$NC" -le "$TC" ] && [ "$NR" -le "$TR" ]; }

case "$MODE" in
prerender)
    [ -n "$WD" ] && [ -d "$WD" ] && [ -n "$can_measure" ] || exit 0
    ensure_links
    order=()
    for cfg in "${CONFIGS[@]}"; do
        get_variant "$cfg" || continue
        KNOWN[${cfg##*/}]="$NC $NR"
        order+=("${cfg##*/}")
    done
    save_sizes
    # Store with this window's image (if it has one already), then the order: only from now on
    # fastfetch.zsh redraws directly from these files
    [ -s "$WD/img" ] && load_img < <(tail -n +2 "$WD/img")
    write_fixed_all
    printf '%s\n' "${order[@]}" > "$WD/order.tmp.$$" && mv -f "$WD/order.tmp.$$" "$WD/order"
    # Snapshot for the next kitty (shown there right away until its fresh values are ready)
    if mkdir -p "$SNAP" 2>/dev/null; then
        for name in "${order[@]}"; do
            cp -f "$WD/$name.out" "$SNAP/$name.out.tmp.$$" && mv -f "$SNAP/$name.out.tmp.$$" "$SNAP/$name.out"
            cp -f "$WD/$name.size" "$SNAP/$name.size.tmp.$$" && mv -f "$SNAP/$name.size.tmp.$$" "$SNAP/$name.size"
        done
        printf '%s\n' "${order[@]}" > "$SNAP/order.tmp.$$" && mv -f "$SNAP/order.tmp.$$" "$SNAP/order"
    fi
    exit 0
    ;;
redraw)
    CUR=${2:--}
    WANT_SRC=${3:-}
    [ -n "$size_ok" ] && [ -n "$can_measure" ] || { echo same; exit 3; }
    ensure_links
    for cfg in "${CONFIGS[@]}"; do
        get_variant "$cfg" || continue
        if fits; then
            # The shown variant still fits and no larger one does: do nothing (kitty already shows it correctly)
            [ "${cfg##*/}" = "$CUR" ] && { echo same; exit 3; }
            with_img "$cfg" "$OUT"
            printf 'shown\t%s\t%s\n' "${cfg##*/}" "${CHOSEN_SRC:-$WANT_SRC}"
            printf '%s' "$FIXED"
            exit 0
        fi
    done
    [ "$CUR" = "-" ] && { echo same; exit 3; }
    echo none
    exit 1
    ;;
esac

# ---- start ----
WANT_SRC=
TTY=/dev/tty
if [ -z "$size_ok" ] || [ -z "$can_measure" ]; then
    # Size unknown (or measuring doesn't work): just the normal variant
    ensure_links
    OUT=$(run_ff "$DIR/config.jsonc"); OUT=${OUT%x}
    with_img "$DIR/config.jsonc" "$OUT"
    printf '%s' "$FIXED" > "$TTY"
    printf 'shown\t%s\t%s\n' "config.jsonc" "$CHOSEN_SRC"
    exit 0
fi

# 1) Instant: the largest fitting variant from the last kitty's snapshot (measured exactly)
SHOWN=; SHOWN_OUT=
snap_ok=
if [ -s "$SNAP/order" ]; then
    snap_ok=1
    for f in "${CONFIGS[@]}" "$DIR/.prompt-lines"; do [ "$f" -nt "$SNAP/order" ] && snap_ok=; done
fi
if [ -n "$snap_ok" ]; then
    DEFER=1
    for cfg in "${CONFIGS[@]}"; do
        name=${cfg##*/}
        [ -f "$SNAP/$name.size" ] && [ -f "$SNAP/$name.out" ] || continue
        read -r NC NR < "$SNAP/$name.size"
        [[ "${NC:-}" =~ ^[0-9]+$ && "${NR:-}" =~ ^[0-9]+$ ]] || continue
        if fits; then
            slurp OUT "$SNAP/$name.out"
            with_img "$cfg" "$OUT"
            # Without an image file for this window, better show nothing old
            if [ -z "${SRCOF[$cfg]:-}" ] || [ -n "${IMG[${CELLSOF[$cfg]}]:-}" ]; then
                printf '%s' "$FIXED" > "$TTY"
                SHOWN=$cfg; SHOWN_OUT=$FIXED
            fi
            break
        fi
    done
    DEFER=
    [ -z "$PENDING" ] || commit_img
fi

# 2) Fresh: run fastfetch now and swap in the values (same variant if it still fits)
ensure_links
CHOSEN=; CHOSEN_OUT=
started=
for cfg in "${CONFIGS[@]}"; do
    name=${cfg##*/}
    # Already shown instantly: start at this variant (the larger ones didn't fit in the snapshot already)
    if [ -n "$SHOWN" ] && [ -z "$started" ]; then
        [ "$cfg" = "$SHOWN" ] || continue
    fi
    started=1
    [ -z "${SRCOF[$cfg]:-}" ] || [ -e "${SRCOF[$cfg]}" ] || continue
    if [ -z "$SHOWN" ] && [ -n "${KNOWN[$name]:-}" ]; then
        read -r kc kr <<< "${KNOWN[$name]}"
        # Clearly too large: skip (uptime, package count etc. only change the width by a few characters)
        if [ "$kc" -gt $((TC + 4)) ] || [ "$kr" -gt $((TR + 1)) ]; then continue; fi
    fi
    fresh_variant "$cfg" || continue
    KNOWN[$name]="$NC $NR"
    if fits; then
        with_img "$cfg" "$OUT"
        CHOSEN=$cfg; CHOSEN_OUT=$FIXED
        break
    fi
done
save_sizes

if [ -n "$CHOSEN" ]; then
    if [ -z "$SHOWN" ]; then
        printf '%s' "$CHOSEN_OUT" > "$TTY"
    elif [ "$CHOSEN_OUT" != "$SHOWN_OUT" ]; then
        printf '%s' "$REDRAW_PRE$CHOSEN_OUT$REDRAW_POST" > "$TTY"
    fi
    write_fixed_all
    printf 'shown\t%s\t%s\n' "${CHOSEN##*/}" "$CHOSEN_SRC"
    exit 0
fi
# Nothing fits (anymore): remove the instant display again
[ -n "$SHOWN" ] && printf '%s' "$REDRAW_PRE$REDRAW_POST" > "$TTY"
echo none
exit 1
