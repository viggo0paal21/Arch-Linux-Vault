* {
  font-family: "JetBrainsMono Nerd Font", monospace;
  font-size: 14px;
  font-weight: 600;
  border: none;
  border-radius: 0;
  box-shadow: none;
  text-shadow: none;
}

window#waybar {
  background: #000000;
  color: #ffffff;
}

/* Workspaces */
#workspaces {
  background: #000000;
  margin: 5px 4px;
}

#workspaces button {
  padding: 0 10px;
  margin: 0 3px;
  background: #1f1f1f;
  color: #ffffff;
  border-radius: 5px;
  box-shadow: none;
}

#workspaces button.active {
  background: #ffffff;
  color: #000000;
}

#workspaces button.urgent {
  background: #ffffff;
  color: #000000;
}

#workspaces button:hover {
  background: #555555;
  color: #ffffff;
  box-shadow: none;
}

/* Rounded grey boxes for status modules */
#clock,
#pulseaudio,
#network,
#cpu,
#memory,
#tray,
#battery,
#bluetooth,
#backlight,
#temperature,
#disk,
#idle_inhibitor,
#language,
#keyboard-state,
#custom-media,
#custom-notification,
#custom-power,
#custom-launcher {
  background: #1f1f1f;
  color: #ffffff;
  padding: 0 12px;
  margin: 5px 4px;
  border-radius: 5px;
  box-shadow: none;
}

/* Tray icons */
#tray {
  padding: 0 10px;
}

#tray > .passive {
  -gtk-icon-effect: dim;
}

#tray > .needs-attention {
  background: #ffffff;
  color: #000000;
  border-radius: 3px;
}

/* Tooltips */
tooltip {
  background: #000000;
  color: #ffffff;
  border: 1px solid #ffffff;
  border-radius: 4px;
}

/* Tray context menus */
menu {
  background: #1f1f1f;
  color: #ffffff;
  border-radius: 5px;
  padding: 4px;
}

menuitem {
  background: transparent;
  color: #ffffff;
  border-radius: 5px;
  padding: 4px 10px;
  margin: 1px 0;
}

menuitem:hover {
  background: #555555;
  color: #ffffff;
}

menuitem:disabled {
  color: #9a9a9a;
}

menu separator {
  background: #555555;
  min-height: 1px;
  margin: 4px 0;
}

