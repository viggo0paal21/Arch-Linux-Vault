{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/logo", "hyprland/workspaces", "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "pulseaudio",
    "bluetooth",
    "network"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "tooltip": false,
    "format-icons": {
        "active": "●", 
        "default": "●", 
        "empty": "●"
    }
  },

  "custom/logo": {
    "format": "\udb82\udcc7",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 50
  },

  "bluetooth": {
    "format": "\udb80\udcaf",
    "format-off": "\udb80\udcb2",
    "format-disabled": "",
    "format-connected": "\udb80\udcb1 {num_connections}",
    "on-click": "blueman-manager"
  },

  "cpu": {
    "format": "\uf4bc {usage}%",
    "interval": 2
  },

  "memory": {
    "format": "\uefc5 {}%",
    "interval": 5
  },

  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\udb80\ude00",
    "format-disconnected": "\udb81\uddaa",
    "on-click": "nm-wifi-gui"
  },

  "pulseaudio": {
    "format": "\uefcf {volume}%",
    "format-muted": "\ueee8"
  },

  "clock": {
    "format": "{:%a %d.%m.  %H:%M}"
  },

  "tray": {
    "spacing": 8
  }
}