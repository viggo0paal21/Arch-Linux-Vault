{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "margin-top": 10,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/logo", "hyprland/workspaces", "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "pulseaudio",
    "network"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
        "active": "●", 
        "default": "○", 
        "empty": "○"
    }
  },

  "custom/logo": {
    "format": "\udb82\udcc7"
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 50
  },

  "cpu": {
    "format": "\uf4bc {usage}%",
    "interval": 2
  },

  "memory": {
    "format": "\uefc5 {}%",
    "interval": 5
  },

  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Offline"
  },

  "pulseaudio": {
    "format": "\uefcf {volume}%",
    "format-muted": "\ueee8"
  },

  "clock": {
    "format": "{:%a %d.%m.  %H:%M}"
  },

  "tray": {
    "spacing": 8
  }
}