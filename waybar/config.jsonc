// ~/.config/waybar/config.jsonc
// Left: Arch logo, workspaces, CPU, RAM, weather. Right: the rest + clock.
// Icons need a Nerd Font (e.g. ttf-jetbrains-mono-nerd).
{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "exclusive": true,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/arch",
    "hyprland/workspaces",
    "cpu",
    "custom/memory",
    "custom/weather",
    "hyprland/window"
  ],
  "modules-center": [],
  "modules-right": [
    "pulseaudio",
    "network",
    "bluetooth",
    "battery",
    "tray",
    "custom/clock"
  ],

  // Invisible – only provides the .solo class (black with exactly one window)
  "hyprland/window": {
    "format": "",
    "separate-outputs": true
  },

  // ---------- left ----------
  "custom/arch": {
    "format": "",
    "tooltip": false,
    "on-click": "hyprlauncher"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "default": "" },
    "persistent-workspaces": { "*": 5 },
    "sort-by-number": true,
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "cpu": {
    "interval": 2,
    "align": 0,
    "format": " {usage}%",
    "tooltip-format": "CPU: {usage}%  ·  {avg_frequency} GHz"
  },

  // Memory with two decimals (e.g. "42.19%")
  "custom/memory": {
    "interval": 3,
    "format": " {}",
    "exec": "awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{printf \"%.2f%%\", (t-a)/t*100}' /proc/meminfo",
    "tooltip": false
  },

  // Weather: only reads what clock.sh fetches every 15 min anyway (no separate script needed).
  // Shows up once the first weather has been loaded.
  "custom/weather": {
    "interval": 60,
    "return-type": "json",
    "exec-if": "test -s \"${XDG_RUNTIME_DIR:-/tmp}/waybar-clock-weather.txt\"",
    "exec": "jq -Rc 'split(\"  \") | {text: (.[0] + \" \" + .[1]), tooltip: .[3]}' \"${XDG_RUNTIME_DIR:-/tmp}/waybar-clock-weather.txt\""
  },

  // ---------- right ----------
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": " Mute",
    "format-icons": { "default": ["", "", ""] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc}"
  },

  "network": {
    "interval": 5,
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-linked": "󰈀 No IP",
    "format-disconnected": "󰖪 Offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "on-click": "kitty -e nmtui"
  },

  "bluetooth": {
    "format": " On",
    "format-off": " Off",
    "format-disabled": " Off",
    "format-connected": " {device_alias}",
    "format-no-controller": "",
    "on-click": "blueman-manager",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}"
  },

  // Hides itself on a desktop without a battery
  "battery": {
    "interval": 30,
    "states": { "warning": 25, "critical": 12 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10,
    "show-passive-items": true
  },

  // Time only – date + weather show up as a tooltip on hover
  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "restart-interval": 2,
    "align": 1,
    "escape": true
  }
}
