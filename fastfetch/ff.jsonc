// ff: das kleine fastfetch (Start von zsh). Aufruf: fastfetch -c ff  (Alias "ff" in ~/.zshrc)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",



    // SMALL ARCH LOGO IN WHITE
    "logo": {
        "type": "builtin",
        "source": "arch_small",
        "color": { "1": "white", "2": "white" },
        "padding": { "left": 1, "right": 3 }
    },


        // KEYS AND TITLES IN WHITE
    "display": {
        "separator": " ",
        "color": { "keys": "90", "title": "bright_white" },
        "percent": { "type": 1 }    // percentages as plain white numbers
    },

    // TITLES ON THE RIGHT
    "modules": [
        { "type": "title",    "key": "User:",     "format": "Viggo" },
        { "type": "os",       "key": "OS:",       "format": "Arch (btw)" },
        { "type": "shell",    "key": "Shell:",    "format": "{pretty-name}" },
        { "type": "wm",       "key": "WM:",       "format": "{pretty-name}" },
        { "type": "disk", "key": "Disk:", "format": "{size-used} / {size-total} ({size-percentage})"},
        { "type": "memory",   "key": "Memory:",   "format": "{used} / {total} ({percentage})" }
    ]
}