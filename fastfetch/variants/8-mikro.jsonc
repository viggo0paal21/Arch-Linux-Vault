{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "color": {
            "keys": "white",
            "title": "bright_white",
            "output": "bright_white",
            "separator": "90"
        },
        "percent": {
            "color": {
                "green": "white",
                "yellow": "bright_white",
                "red": "bright_white"
            }
        },
        "bar": {
            "color": {
                "elapsed": "bright_white",
                "total": "90",
                "border": "90"
            }
        }
    },
    "modules": [
        {
            "type": "os",
            "key": " ",
            "keyColor": "bold_bright_white",
            "format": "{name}"
        },
        {
            "type": "uptime",
            "key": "󰅐",
            "keyColor": "white"
        }
    ]
}
