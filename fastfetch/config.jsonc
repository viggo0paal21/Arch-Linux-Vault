// Das grosse fastfetch: startet mit "fastfetch" ohne Optionen.
// Das kleine fuer den zsh-Start liegt in ff.jsonc (Alias "ff").
//
// Auswaehlen: Zeilen mit // davor sind aus. // weg = an, // davor = aus.
// Reihenfolge der Zeilen = Reihenfolge der Anzeige.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // GROSSES ARCH-LOGO IN WEISS
    "logo": {
        "type": "file",
        "source": "/home/viggo/.config/fastfetch/hent.txt",
        "color": { "1": "white", "2": "white" },
        "padding": { "left": 1, "right": 3 }
    },

    // SCHLUESSEL GRAU, TITEL WEISS (wie ff)
    "display": {
        "separator": " ",
        "color": { "keys": "90", "title": "bright_white" },
        "percent": { "type": 1 }
    },

    "modules": [
        { "type": "title",    "key": "User:",     "format": "Viggo" },
        "separator",
        { "type": "os",       "key": "OS:",       "format": "Arch (btw)" },
        { "type": "kernel",   "key": "Kernel:" },
        { "type": "uptime",   "key": "Uptime:" },
        { "type": "packages", "key": "Packages:" },
        { "type": "shell",    "key": "Shell:",    "format": "{pretty-name}" },
        { "type": "wm",       "key": "WM:",       "format": "{pretty-name}" },
        { "type": "terminal", "key": "Terminal:", "format": "{pretty-name}" },
        // { "type": "terminalfont", "key": "Font:" },
        // { "type": "theme",    "key": "Theme:" },
        // { "type": "icons",    "key": "Icons:" },
        // { "type": "cursor",   "key": "Cursor:" },
        { "type": "display",  "key": "Display:" },
        "break",
        { "type": "cpu",      "key": "CPU:" },
        // GPU ohne Temperatur und per PCI: die NVIDIA-Abfrage (NVML) hat frueher kurz alles eingefroren
        { "type": "gpu",      "key": "GPU:", "temp": false, "detectionMethod": "pci" },
        { "type": "memory",   "key": "Memory:",   "format": "{used} / {total} ({percentage})" },
        // { "type": "swap",     "key": "Swap:" },
        { "type": "disk",     "key": "Disk:",     "format": "{size-used} / {size-total} ({size-percentage})" },
        // { "type": "localip",  "key": "IP:" },
        // { "type": "locale",   "key": "Locale:" },
        // Farbpalette des Terminals als Punkte (bunt, passt nicht zu Schwarz-Weiss, darum aus)
        // { "type": "colors", "symbol": "circle" }
        "break"
    ]
}